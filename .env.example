APP_NAME="Umar Techy E-Commerce Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Retention (days) of storage/logs/audit.log — see config/logging.php.
LOG_AUDIT_DAYS=365

# --- Database (MySQL 8.0+, shared multi-tenant DB — see ADR-001/003) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umartechy_ecommerce
DB_USERNAME=
DB_PASSWORD=

# --- Cache / Queue / Session (Redis — see ADR-001 tenant-prefixed keys) ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Security baseline (config/security.php). Both default to on.
# MFA_REQUIRED_FOR_PLATFORM_STAFF=true
# MFA_REQUIRED_FOR_STORE_OWNERS=true
# STEP_UP_ENABLED=true
# STEP_UP_TTL_MINUTES=15
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Sanctum (canonical first-party auth — ADR-002) ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# --- Object Storage (S3-compatible — see Module 20 / Bible Data Architecture) ---
FILESYSTEM_DISK=local
# Photos on return requests (B34). Must be a PRIVATE disk: they are served
# only through the API to the store's staff and the person who asked.
RETURN_PHOTO_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Search (MySQL Full-Text initially; Meilisearch later — Approved Stack) ---
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Realtime (Laravel Reverb) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Mail / Notifications (Module 21) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@umartechy.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Outbox dispatcher (ADR-004) ---
OUTBOX_DISPATCH_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETENTION_DAYS=90

# --- Packages / Entitlements / Trial (Module 04) ---
DEFAULT_TRIAL_PACKAGE_CODE=basic
DEFAULT_TRIAL_DAYS=14
ENTITLEMENT_CACHE_TTL_MINUTES=5

# --- Security, Audit & Compliance (Module 32 — config/compliance.php) ---
AUDIT_RETENTION_DAYS=365
AUDIT_MIRROR_TO_LOG=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

# --- Store Health / Monitoring (Module 24 — config/monitoring.php) ---
# Defaults, not measured values; tune once real traffic exists.
STORE_HEALTH_USAGE_WARNING_PERCENT=80
STORE_HEALTH_TRIAL_WARNING_DAYS=3
STORE_HEALTH_OUTBOX_STALE_MINUTES=15
STORE_HEALTH_FAILURE_WINDOW_HOURS=24
STORE_HEALTH_BACKUP_MAX_AGE_HOURS=48

# Backups (config/backup.php, docs/operations/backup-and-restore.md).
# The key: `php artisan backups:generate-key`. Never keep it with the backups.
BACKUP_ENCRYPTION_KEY=
# BACKUP_DISK=local
# BACKUP_MYSQLDUMP_BINARY=mysqldump
# BACKUP_MYSQL_BINARY=mysql
# BACKUP_SCHEDULE_AT=02:00
# BACKUP_VERIFY_AT=04:00
# BACKUP_REHEARSAL_DAY=0
# BACKUP_REHEARSAL_AT=05:00
STORE_HEALTH_SNAPSHOT_RETENTION_DAYS=30

# NOTE: This file documents every environment variable required to run the
# platform (Milestone-0 Step 0.7). No real secret values are ever committed —
# copy this file to .env and fill in real values locally / in the deployment
# secret manager only.

# Module 29 — platform billing (Phase B23)
BILLING_CURRENCY=PKR
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=Tax
BILLING_INVOICE_PREFIX=INV-
BILLING_ISSUE_DAYS_BEFORE=7
BILLING_GRACE_AFTER_DAYS=3
BILLING_SUSPEND_AFTER_DAYS=10
BILLING_EXPIRE_AFTER_DAYS=40

# Module 05 — storefront (Phase B24). Public images need `php artisan storage:link`.
STOREFRONT_BASE_URL="${APP_URL}/shop"
STOREFRONT_CACHE_TTL=600
STOREFRONT_LOW_STOCK_THRESHOLD=5
STOREFRONT_IMAGE_DISK=public

# Module 34 — support (Phase B26)
SUPPORT_REOPEN_DAYS=7
