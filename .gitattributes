# Source specifications are stored byte-for-byte as supplied (see docs/source/README.md checksums).
docs/source/**/*.txt -text
docs/source/SHA256SUMS -text

# Deployment: shell scripts and container config run on Linux; keep LF.
*.sh text eol=lf
docker/** text eol=lf
docker-compose*.yml text eol=lf
Dockerfile text eol=lf
