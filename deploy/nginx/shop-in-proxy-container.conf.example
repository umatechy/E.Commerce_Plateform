# Umar Techy E-Commerce — a NEW site file for an existing Nginx that runs in a
# container (on the Umar Techy server: School ERP's utschoolerp-nginx-1, whose
# conf.d is /opt/utschoolerp/deploy/nginx/conf.d on the host).
# docs/deployment/production.md, steps A6–A7. Replace SHOP_DOMAIN.
#
# It only ADDS server blocks for SHOP_DOMAIN: no default_server, no change to
# any other file. The shop's web container joins that Nginx's network
# (deploy/production/compose.shared-proxy.yml) as "umartechy-shop-web".
#
# Safety for the other application:
#   - The upstream is a variable resolved by Docker's DNS at request time, so
#     this Nginx still starts (and reloads) when the shop's container is down
#     — only the shop then answers 502.
#   - This server block has its own add_header, so the other application's
#     global headers (its CSP and Permissions-Policy "payment=()", from
#     conf.d/01-security-headers.conf) are NOT applied to the shop; the shop
#     sends its own security headers (Laravel, AddSecurityHeaders).
#   - The HTTPS block (PHASE 2) refers to a certificate file; enable it only
#     after the certificate exists, or the whole Nginx would refuse to start.
#
# Apply (each step only with approval; check, then reload — never restart):
#   cp shop-in-proxy-container.conf /opt/utschoolerp/deploy/nginx/conf.d/20-umartechy-shop.conf
#   docker exec utschoolerp-nginx-1 nginx -t && docker exec utschoolerp-nginx-1 nginx -s reload
# Undo: remove the file, then the same two commands.

# ---- PHASE 1: HTTP — certificate challenge, then redirect ------------------
server {
    listen 80;
    listen [::]:80;
    server_name SHOP_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

