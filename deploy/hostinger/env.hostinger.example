# Shared hosting (docs/deployment/hostinger.md). Copy to ~/shop/shared/.env on
# the server, CHANGE the values there, and never commit the copy.
APP_NAME="Umar Techy"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (run on the server; do not paste it anywhere else)
APP_KEY=
# CHANGE: the shop's main address, with https://
APP_URL=https://CHANGE
LOG_CHANNEL=stack
LOG_LEVEL=info

# hPanel -> Databases. Names carry the account's prefix.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE
DB_USERNAME=CHANGE
DB_PASSWORD=CHANGE

# No Redis on shared hosting: all in the database.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
QUEUE_CONNECTION=database
QUEUE_FROM_SCHEDULER=true
# Longer than the longest job, or a job could run twice.
DB_QUEUE_RETRY_AFTER=900

# CHANGE: the shop's main address, without https://
SANCTUM_STATEFUL_DOMAINS=CHANGE
MFA_ISSUER="Umar Techy"
MFA_REQUIRED_FOR_PLATFORM_STAFF=true
# Hostinger's CDN must stay off for the shop, so no proxy is trusted.
TRUSTED_PROXIES=

# CHANGE: the domain the owner chooses. Subdomains stay records only.
PLATFORM_BASE_DOMAIN=CHANGE
PLATFORM_SUBDOMAINS_PUBLIC=false
# CHANGE: the website's IP in hPanel, which customers point their domains to.
SHOP_PUBLIC_IPV4=
STOREFRONT_BASE_URL=https://CHANGE/shop
STOREFRONT_IMAGE_DISK=public

FILESYSTEM_DISK=local
RETURN_PHOTO_DISK=local
# Off this account: the existing S3 bucket (config/filesystems.php).
BACKUP_DISK=backups_s3
BACKUP_ENCRYPTION_KEY=CHANGE
# Full paths if the shell does not find them.
# BACKUP_MYSQLDUMP_BINARY=mysqldump
# BACKUP_MYSQL_BINARY=mysql
# hPanel makes databases, SQL cannot: make an empty one whose name ends in
# _rehearsal, with its own user. Each rehearsal empties it afterwards.
BACKUP_REHEARSAL_DATABASE=CHANGE_rehearsal
BACKUP_REHEARSAL_USERNAME=CHANGE
BACKUP_REHEARSAL_PASSWORD=CHANGE

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=CHANGE
MAIL_PASSWORD=CHANGE
MAIL_FROM_ADDRESS=CHANGE
MAIL_FROM_NAME="Umar Techy"
