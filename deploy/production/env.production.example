# Umar Techy E-Commerce — production settings (docs/deployment/production.md).
#
# Copy to /opt/umartechy-ecommerce/.env on the server, owner the deploy user,
# mode 600. Never commit the filled-in file. Values marked CHANGE must be set;
# the others are safe defaults. Generate secrets ON THE SERVER:
#   APP_KEY                 docker compose ... run --rm --no-deps app php artisan key:generate --show
#                           (or: echo "base64:$(openssl rand -base64 32)")
#   DB_PASSWORD / REDIS_PASSWORD   openssl rand -base64 33 | tr -d '/+=' | cut -c1-40
#   BACKUP_ENCRYPTION_KEY   openssl rand -base64 32   — keep an offline copy, never with the backups
# The MySQL root password goes in mysql.env (see mysql.env.example), not here.

# --- Compose: this project on the shared server ---------------------------
# A port free on the server's 127.0.0.1 (checked by deploy/production/preflight.sh).
ECOM_HTTP_PORT=CHANGE
# A /24 no other Docker network or host route uses (preflight.sh lists them).
ECOM_APP_SUBNET=172.30.240.0/24
IMAGE_TAG=current
# Resource limits (defaults suit a server with ~2 GB to spare; preflight.sh shows what is free).
# APP_CPUS=1.0
# APP_MEMORY=768M
# WORKER_CPUS=0.5
# WORKER_MEMORY=512M
# SCHEDULER_CPUS=0.25
# SCHEDULER_MEMORY=256M
# WEB_CPUS=0.5
# WEB_MEMORY=128M
# MYSQL_CPUS=1.0
# MYSQL_MEMORY=1G
# MYSQL_BUFFER_POOL=256M
# REDIS_CPUS=0.25
# REDIS_MEMORY=256M
# PHP_FPM_MAX_CHILDREN=12

# --- Application -------------------------------------------------------------
APP_NAME="Umar Techy"
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE
APP_TIMEZONE=UTC
# The e-commerce subdomain, with https:// (CHANGE).
APP_URL=https://CHANGE
# Who reaches the shop's web container, and is believed for the visitor's IP
# and HTTPS: this project's network (local checks through 127.0.0.1:<port>)
# and, on a shared server, the existing proxy's network. On the Umar Techy
# server School ERP's Nginx is a container on utschoolerp_internal
# (172.18.0.0/16 — re-check with preflight.sh before deploying).
TRUSTED_PROXIES=172.30.240.0/24,172.18.0.0/16
# The existing proxy's Docker network the shop's web container also joins
# (deploy/production/compose.shared-proxy.yml). Empty on a server whose web
# server runs on the host and proxies to 127.0.0.1:ECOM_HTTP_PORT.
SHARED_PROXY_NETWORK=utschoolerp_internal

# Logs go to Docker (rotated by the Compose file); the audit log stays a file in its volume.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_AUDIT_DAYS=365

# --- Database (the project's own MySQL 8 container) -----------------------
DB_DATABASE=umartechy_ecommerce
DB_USERNAME=umartechy_app
DB_PASSWORD=CHANGE

# --- Redis (the project's own container; cache, queue, sessions) ----------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_PASSWORD=CHANGE

# --- Sessions and first-party auth over HTTPS -----------------------------
SESSION_SECURE_COOKIE=true
# Empty: the cookie belongs to the exact host (stores on their own domains keep theirs).
SESSION_DOMAIN=
# The e-commerce subdomain without https:// (CHANGE).
SANCTUM_STATEFUL_DOMAINS=CHANGE

# --- Security ------------------------------------------------------------------
MFA_ISSUER="Umar Techy"
MFA_REQUIRED_FOR_PLATFORM_STAFF=true
MFA_REQUIRED_FOR_STORE_OWNERS=false
STEP_UP_ENABLED=true
STEP_UP_TTL_MINUTES=15
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
AUDIT_RETENTION_DAYS=365
AUDIT_MIRROR_TO_LOG=true

# --- Stores' own addresses ---------------------------------------------------
# Each store also gets <slug>.PLATFORM_BASE_DOMAIN; that needs wildcard DNS and
# a wildcard certificate (not part of the first launch — stores open at
# APP_URL/shop/<slug> meanwhile). CHANGE to the domain the owner chooses.
PLATFORM_BASE_DOMAIN=CHANGE
STOREFRONT_BASE_URL=https://CHANGE/shop
STOREFRONT_IMAGE_DISK=public

# --- Files and backups -------------------------------------------------------
FILESYSTEM_DISK=local
RETURN_PHOTO_DISK=local
BACKUP_DISK=local
BACKUP_ENCRYPTION_KEY=CHANGE
# BACKUP_SCHEDULE_AT=02:00
# BACKUP_VERIFY_AT=04:00
# BACKUP_REHEARSAL_DAY=0
# BACKUP_REHEARSAL_AT=05:00
# Off-server backups: an S3-compatible bucket (config/filesystems.php, disk
# "backups_s3"). On the Umar Techy server: Hetzner Object Storage, Helsinki.
# Switch with BACKUP_DISK=backups_s3 once the bucket and its keys are set.
# The two keys go in with deploy/production/set-secret.sh, never by hand.
# BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
# BACKUP_S3_REGION=eu-central
# BACKUP_S3_BUCKET=umartechy-store-backups
# BACKUP_S3_PATH_STYLE=false
# BACKUP_S3_ACCESS_KEY=      (set-secret.sh)
# BACKUP_S3_SECRET_KEY=      (set-secret.sh)

# --- Mail. "log" sends nothing. ----------------------------------------------
# (Write values out in full: this file does not expand ${...} references.)
# Hostinger mailbox: smtp.hostinger.com, port 465 with MAIL_SCHEME=smtps
# (or 587 with MAIL_SCHEME=smtp, upgraded to TLS). The password goes in with
# deploy/production/set-secret.sh.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=info@umartechy.com
# MAIL_PASSWORD=             (set-secret.sh)
MAIL_FROM_ADDRESS=CHANGE
MAIL_FROM_NAME="Umar Techy"

# --- Test providers: always off in production --------------------------------
PAYMENTS_SIMULATOR=false
COURIERS_SIMULATOR=false
MESSAGING_SIMULATOR=false

# --- Store app push (owner input: VAPID keys, e.g. `npx web-push generate-vapid-keys`) ---
# PWA_VAPID_PUBLIC_KEY=
# PWA_VAPID_PRIVATE_KEY=
# PWA_VAPID_SUBJECT=mailto:CHANGE

# --- Platform billing (owner decisions; tax is never assumed) ---------------
BILLING_CURRENCY=PKR
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=Tax
BILLING_INVOICE_PREFIX=INV-
DEFAULT_TRIAL_PACKAGE_CODE=basic
DEFAULT_TRIAL_DAYS=14

# Search runs on MySQL full-text.
SCOUT_DRIVER=database
